{
  "name": "@ccb/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared API contracts and schemas for Crash Course Builder.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
