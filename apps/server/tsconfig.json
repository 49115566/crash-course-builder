{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "rootDir": ".",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
